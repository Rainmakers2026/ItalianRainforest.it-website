# ---------------------------------------------------------------------------
# Italian Rainforest 2.0 — environment variables
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Canonical public URL (used for canonical/hreflang, sitemap, OG, embed codes).
# TODO(owner): confirm the production domain.
NEXT_PUBLIC_SITE_URL=https://www.italianrainforest.it

# --- Data source: Airtable "Rainmakers OS" (READ-ONLY) -------------------------
# Leave empty to use the snapshot of the IRF database export
# (data/snapshot/irf-records.json, built by `npm run data:import`).
# Set these three and map, database, infographic section and every number on the
# site read the "Rainmakers OS" base instead (same columns: COMPANY NAME, WEBSITE,
# SHORT DESCRIPTION, PLAYER TYPE, ADDRESS, REGION, CITY, INDUSTRY, STATUS, LOGO, …).
# Token: Personal Access Token with ONLY `data.records:read` on that base.
# The site never writes to this base; see scripts/check-airtable-readonly.mjs.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=
# Prefer a dedicated view that excludes STARTUP rows, e.g. "IRF public".
AIRTABLE_VIEW=
# Optional: column names if they differ from the defaults (see src/lib/data/normalize.ts), e.g.
# AIRTABLE_FIELD_MAP={"name":"COMPANY NAME","types":"PLAYER TYPE","osm":"OPEN STREET MAP"}
AIRTABLE_FIELD_MAP=

# Data cache / revalidation (seconds) and staleness warning threshold (days).
DATA_REVALIDATE_SECONDS=3600
DATA_STALE_AFTER_DAYS=60

# Deprecated: positions are now real (geocoded from the database addresses).
IRF_GEO_DEMO=false

# --- Form submissions → Supabase (system of record) ---------------------------
# Every public form is stored in Supabase BEFORE the site answers: no success is shown
# when the write fails. Without these three values production refuses submissions (503);
# development only logs a redacted notice. Tables and SQL: supabase/sql/.
#   /api/signup (embed)      → sharing_is_caring_registrations
#   /api/signup (downloads)  → download_registrations
#   /api/download (POST)     → download_registrations
#   /api/suggest             → database_update_requests
#   newsletter checkbox      → newsletter_subscribers
# SERVER ONLY: never prefix these with NEXT_PUBLIC_, never commit real values.
# Supabase → Project Settings → Data API (URL) and → API Keys (service_role / secret key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Version of the privacy notice the visitor accepts (stored with every consent).
# "draft-2026-11" is for tests / preview only, until the notice is legally validated.
PRIVACY_POLICY_VERSION=
# Optional: version of the newsletter consent text (defaults to PRIVACY_POLICY_VERSION).
NEWSLETTER_CONSENT_VERSION=

# --- RAINFOREST RADAR newsletter (docs/newsletter.md) ---------------------------
# Every integration stays OFF until its variables are set; nothing is simulated.
# SERVER ONLY: never NEXT_PUBLIC_, never committed.
#
# Brevo (Settings → SMTP & API → API keys; list / templates ids from the Brevo UI).
# The RADAR list must be separate from GOCCE. The DOI template is a Brevo
# "double opt-in" template whose button uses {{ params.DOIurl }}.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_WELCOME_TEMPLATE_ID_IT=
BREVO_WELCOME_TEMPLATE_ID_EN=
# Bearer token configured on the Brevo marketing webhook (≥ 24 characters, random).
BREVO_WEBHOOK_SECRET=
# Contact attributes that EXIST in the Brevo account (others are not sent).
BREVO_CONTACT_ATTRIBUTES=FIRSTNAME,LASTNAME
# Signs the confirmation links (≥ 32 random characters).
NEWSLETTER_TOKEN_SECRET=
# Protects /api/newsletter/reconcile (Vercel Cron uses CRON_SECRET; ≥ 24 characters).
NEWSLETTER_CRON_SECRET=
# Public origin of the confirmation link. Empty: Preview uses VERCEL_BRANCH_URL,
# otherwise NEXT_PUBLIC_SITE_URL.
NEWSLETTER_PUBLIC_URL=
#
# Airtable sync base "IRF push da Supabase" — SEPARATE from the read-only data base above
# (AIRTABLE_BASE_ID / AIRTABLE_TOKEN are the Rainmakers OS master and are never used here).
# PAT scopes: data.records:read + data.records:write on this base only
# (+ schema.bases:read for `npm run airtable:schema-check`).
AIRTABLE_SYNC_PAT=
AIRTABLE_SYNC_BASE_ID=
# ISCRITTI ALLA NEWSLETTER / DISISCRITTI DALLA NEWSLETTER / IRF - USERS REQUESTS (tbl… ids)
AIRTABLE_NEWSLETTER_SUBSCRIBERS_TABLE_ID=
AIRTABLE_NEWSLETTER_UNSUBSCRIBERS_TABLE_ID=
AIRTABLE_USER_REQUESTS_TABLE_ID=

# --- Leads (legacy extra destinations, optional) -------------------------------
# One-time sign-up (name, surname, email, referent) asked before any download
# (CSV/JSON/PDF/PNG) and before copying the embed code. Sign-ups are appended,
# create-only, to an Airtable APPROVAL table on a SEPARATE staging base — never
# the "Rainmakers OS" base above. Approved contacts are then moved to Rainmakers OS
# by the team (by hand or with an Airtable automation).
# Token: ONLY `data.records:write` on the staging base. Expected columns:
# Nome, Cognome, Email, Referente, Organizzazione, Motivo, Dettaglio, Lingua,
# Consenso marketing (checkbox), UTM, Ricevuto il (date/time), Stato (single select: "Da approvare").
AIRTABLE_LEADS_TOKEN=
AIRTABLE_LEADS_BASE_ID=
AIRTABLE_LEADS_TABLE=
# Optional extra destination (CRM, n8n/Make/Zapier webhook) for every submission.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Community channel (placeholder until the Telegram channel exists).
NEXT_PUBLIC_TELEGRAM_URL=

# Ask for the one-time sign-up before downloads and embed codes.
DOWNLOAD_REQUIRES_EMAIL=true

# --- Analytics (privacy-aware, no PII) ---------------------------------------
# plausible | umami | gtm | none
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
