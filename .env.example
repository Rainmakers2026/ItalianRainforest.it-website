# ---------------------------------------------------------------------------
# Italian Rainforest 2.0 — environment variables
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Canonical public URL (used for canonical/hreflang, sitemap, OG, embed codes).
# TODO(owner): confirm the production domain.
NEXT_PUBLIC_SITE_URL=https://www.italianrainforest.it

# --- Data source (READ-ONLY) --------------------------------------------------
# Leave empty to use the legacy public snapshot in data/snapshot/legacy-records.json.
# The token must be a Personal Access Token with ONLY the `data.records:read`
# scope (and `schema.bases:read` if needed), limited to the Italian Rainforest base.
# The site never writes to Airtable; see scripts/check-airtable-readonly.mjs.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=
# Prefer a dedicated, sanitised view, e.g. "IRF public".
AIRTABLE_VIEW=

# Data cache / revalidation (seconds) and staleness warning threshold (days).
DATA_REVALIDATE_SECONDS=3600
DATA_STALE_AFTER_DAYS=30

# Synthetic map positions for review while Airtable has no geographic fields.
# Positions are labelled "illustrative" in the UI and never exported.
# Set to false as soon as real Region/Province/City/Latitude/Longitude exist.
IRF_GEO_DEMO=true

# --- Leads (never Airtable) ---------------------------------------------------
# Destination for contact requests, downloads and update suggestions
# (CRM, n8n/Make/Zapier webhook, email workflow, moderation queue).
# In production, without a webhook the forms answer 503 and suggest email instead.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Return gated contact fields after a valid request (needs Email/Phone fields in the source).
REVEAL_GATED_CONTACTS=false
# Ask for an email before downloading CSV/JSON (light lead generation).
DOWNLOAD_REQUIRES_EMAIL=true

# --- Analytics (privacy-aware, no PII) ---------------------------------------
# plausible | umami | gtm | none
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
